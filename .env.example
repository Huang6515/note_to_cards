# LLM 接入配置（复制为 .env 或通过环境变量注入）
# 未配置时后端会自动降级为内置示例数据，保证项目可运行

# OpenAI 兼容接口的 API Key（OpenAI / DeepSeek / 通义千问 / Moonshot 等）
LLM_API_KEY=

# 接口地址，默认 OpenAI，末尾可不带 /v1
# DeepSeek:        https://api.deepseek.com
# 通义千问(兼容):  https://dashscope.aliyuncs.com/compatible-mode
# Moonshot:        https://api.moonshot.cn
LLM_BASE_URL=https://api.openai.com

# 模型名称，例如 gpt-4o-mini / deepseek-chat / qwen-plus
LLM_MODEL=gpt-4o-mini

# 请求超时（秒）
LLM_TIMEOUT=60