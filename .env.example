# LLM 接入配置（复制为 .env，或直接注入环境变量）
# 未配置时后端会自动降级为内置示例数据，保证项目开箱可运行。

# ---- 必填（两个都要填才能启用真实模型）----

# OpenAI 兼容接口的 API Key
LLM_API_KEY=

# 模型名称，例如 deepseek-chat / qwen-plus / gpt-4o-mini / glm-4-plus
LLM_MODEL=deepseek-chat

# 接口地址（末尾可不带 /v1，带不带都能识别）
# DeepSeek:        https://api.deepseek.com
# 通义千问(兼容):  https://dashscope.aliyuncs.com/compatible-mode/v1
# Moonshot:        https://api.moonshot.cn/v1
# 智谱 GLM:        https://open.bigmodel.cn/api/paas/v4
# OpenAI:          https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com

# ---- 可选：调用行为 ----

# 请求超时（秒）
LLM_TIMEOUT=60

# 单次生成的最大输出 token 数。太小会导致 JSON 被截断而解析失败。
LLM_MAX_TOKENS=4000

# 上游返回 429/5xx 时的重试次数
LLM_MAX_RETRIES=2

# ---- 可选：服务端保护 ----

# 每个 IP 每分钟允许的生成次数，设 0 关闭限流（默认 10）
RATE_LIMIT_PER_MINUTE=10

# 同时打往模型接口的请求数上限（默认 4）
LLM_MAX_CONCURRENCY=4

# 允许跨域的前端地址，逗号分隔。同源部署时留空即可（默认不允许任何跨域）
ALLOW_ORIGINS=

# 部署在反向代理后面时设为 true，才会信任 X-Forwarded-For 作为客户端 IP
TRUST_PROXY=false

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
